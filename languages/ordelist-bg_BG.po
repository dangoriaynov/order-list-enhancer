#: includes/class-ordelist-extras.php:468
#, php-format
msgid "Split out of combo «%1$s» (%2$s)"
msgstr "Отделено от комбо «%1$s» (%2$s)"

#. translators: 1: the add-on extra label, 2: the price it was converted from.
#: includes/class-ordelist-extras.php:476
#, php-format
msgid "Converted from extra: «%1$s» (was %2$s)"
msgstr "Преобразувано от екстра: «%1$s» (беше %2$s)"

#. translators: %s: the add-on extra label.
#: includes/class-ordelist-extras.php:488
