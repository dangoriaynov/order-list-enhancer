msgstr "невалиден телефон"

#. translators: %s: number of selected orders.
#: includes/class-ordelist-plugin.php:219
#, php-format
msgid "Open selected (%s)"
msgstr "Отвори избраните (%s)"

#: includes/class-ordelist-plugin.php:220
