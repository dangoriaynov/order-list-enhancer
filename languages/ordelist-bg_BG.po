msgstr "Отваряне %1$s / %2$s…"

#. translators: %s: number of orders opened.
#: includes/class-ordelist-plugin.php:225
#, php-format
msgid "Done (%s)"
msgstr "Готово (%s)"

#: includes/class-ordelist-plugin.php:226
msgid "Select some orders first."
msgstr "Първо изберете поръчки."

#: includes/class-ordelist-plugin.php:227
msgid "Pop-ups are blocked - allow them for this site, then try again."
msgstr ""
"Изскачащите прозорци са блокирани - разрешете ги за този сайт и опитайте пак."

