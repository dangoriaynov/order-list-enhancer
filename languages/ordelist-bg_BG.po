#: includes/class-ordelist-delivery-notice.php:37
msgid "📦 This is the SHIPPING date"
msgstr "📦 Това е датата на ИЗПРАЩАНЕ"

#: includes/class-ordelist-delivery-notice.php:38
msgid ""
"Not the date you receive it. Delivery to the courier office usually takes "
"about 1 working day."
msgstr ""
"Не е датата на получаване. Обикновено доставката до офис на куриера отнема "
"около 1 работен ден."

#. translators: %s: vacation end date.
#: includes/class-ordelist-delivery-notice.php:40
#, php-format
msgid ""
"🌴 We are on vacation until %s. Orders placed now will be shipped after that "
"date."
msgstr ""
"🌴 В момента сме в отпуск до %s. Поръчките, направени сега, ще бъдат "
"изпратени след тази дата."

#. translators: 1: order number, 2: minutes ago
#: includes/class-ordelist-dup-guard.php:175
#, php-format
msgid ""
"You already placed a similar order %2$d min ago (#%1$s). To place another "
"one, please contact us."
msgstr ""
"Вече направихте подобна поръчка преди %2$d мин. (№%1$s). За нова поръчка, "
"моля свържете се с нас."

#. translators: 1: order number, 2: minutes ago
#: includes/class-ordelist-dup-guard.php:192
#, php-format
msgid ""
"You already placed a similar order %2$d min ago (#%1$s). Are you sure you "
"want to place another one?"
msgstr ""
"Вече направихте подобна поръчка преди %2$d мин. (№%1$s). Сигурни ли сте, че "
"искате да направите още една?"

#: includes/class-ordelist-dup-guard.php:229
msgid "Yes, order again"
msgstr "Да, поръчай отново"

#: includes/class-ordelist-dup-guard.php:230
msgid "Cancel"
msgstr "Отказ"

#. translators: %d: average number of days between orders.
#: includes/class-ordelist-duplicates.php:93
#, php-format
msgid "once every %d days"
msgstr "веднъж на %d дни"

#: includes/class-ordelist-duplicates.php:95
msgid "same day"
msgstr "същия ден"

#: includes/class-ordelist-duplicates.php:104
msgid "Customer"
msgstr "Клиент"

#: includes/class-ordelist-duplicates.php:306
msgid "phone"
msgstr "телефон"

#: includes/class-ordelist-duplicates.php:307
msgid "e-mail"
msgstr "e-mail"

#: includes/class-ordelist-duplicates.php:308
msgid "name"
msgstr "име"

#: includes/class-ordelist-duplicates.php:309
msgid "address"
msgstr "адрес"

#: includes/class-ordelist-duplicates.php:310
msgid "phone + name"
msgstr "телефон + име"

#: includes/class-ordelist-extras.php:48
msgid "OLE - extras converted to product lines:"
msgstr "OLE - екстрите са преобразувани в продуктови редове:"

#. translators: 1: the add-on extra label, 2: the price it was converted from.
#: includes/class-ordelist-extras.php:192
#, php-format
msgid "Converted from extra: «%1$s» (was %2$s)"
msgstr "Преобразувано от екстра: «%1$s» (беше %2$s)"

#. translators: %s: the add-on extra label.
#: includes/class-ordelist-extras.php:204
#, php-format
msgid "Extra «%s» moved to its own line"
msgstr "Екстра «%s» е преместена на собствен ред"

#: includes/class-ordelist-order-comments.php:34
#: includes/class-ordelist-order-comments.php:38
msgid "Comment"
msgstr "Коментар"

# Checkout phone validation
#: includes/class-ordelist-phone-checkout.php:27
msgid "Looks valid"
msgstr "Изглежда валиден"

#: includes/class-ordelist-phone-checkout.php:28
msgid "Please enter a phone number."
msgstr "Моля, въведете телефонен номер."

#: includes/class-ordelist-phone-checkout.php:29
msgid "The phone number looks too short. Example: 0888 123 456."
msgstr "Телефонният номер изглежда твърде къс. Пример: 0888 123 456."

#: includes/class-ordelist-phone-checkout.php:30
msgid "The phone number looks too long. Example: 0888 123 456."
msgstr "Телефонният номер изглежда твърде дълъг. Пример: 0888 123 456."

#: includes/class-ordelist-phone-checkout.php:31
msgid "Please enter a Bulgarian number (e.g. 0888 123 456)."
msgstr "Моля, въведете български номер (напр. 0888 123 456)."

#: includes/class-ordelist-phone-checkout.php:32
msgid "Invalid phone number. Example: 0888 123 456 or +359 888 123 456."
msgstr "Невалиден телефонен номер. Пример: 0888 123 456 или +359 888 123 456."

#: includes/class-ordelist-phone-checkout.php:97
msgid "Phone may be invalid - please verify."
msgstr "Телефонът може да е невалиден - моля, проверете."

