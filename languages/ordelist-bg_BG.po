#: includes/class-ordelist-delivery-notice.php:37
msgid "This is the SHIPPING date"
msgstr "Това е датата на ИЗПРАЩАНЕ"

#: includes/class-ordelist-delivery-notice.php:38
msgid ""
"Not the date you receive it. Delivery to the courier office usually takes "
"about 1 working day."
msgstr ""
"Не е датата на получаване. Обикновено доставката до офис на куриера отнема "
"около 1 работен ден."

#. translators: %s: vacation end date.
#: includes/class-ordelist-delivery-notice.php:40
#, php-format
msgid ""
"We are on vacation until %s. Orders placed now will be shipped after that "
"date."
msgstr ""
"В момента сме в отпуск до %s. Поръчките, направени сега, ще бъдат изпратени "
"след тази дата."

#. translators: %d: minutes ago
#: includes/class-ordelist-dup-guard.php:190
#, php-format
msgid ""
"You already placed a similar order %d min ago. To place another one, please "
"contact us."
msgstr ""
"Вече направихте подобна поръчка преди %d мин. За нова поръчка, моля свържете "
"се с нас."

#. translators: %d: minutes ago
#: includes/class-ordelist-dup-guard.php:206
#, php-format
msgid ""
"You already placed a similar order %d min ago. Are you sure you want to "
"place another one?"
msgstr ""
"Вече направихте подобна поръчка преди %d мин. Сигурни ли сте, че искате да "
"направите още една?"

#: includes/class-ordelist-dup-guard.php:242
msgid "Yes, order again"
msgstr "Да, поръчай отново"

#: includes/class-ordelist-dup-guard.php:243
msgid "Cancel"
msgstr "Отказ"

#. translators: %d: average number of days between orders.
#: includes/class-ordelist-duplicates.php:93
#, php-format
msgid "once every %d days"
msgstr "веднъж на %d дни"

#: includes/class-ordelist-duplicates.php:95
msgid "same day"
msgstr "същия ден"

#: includes/class-ordelist-duplicates.php:104
msgid "Customer"
msgstr "Клиент"

#: includes/class-ordelist-duplicates.php:306
msgid "phone"
msgstr "телефон"

#: includes/class-ordelist-duplicates.php:307
msgid "e-mail"
msgstr "e-mail"

#: includes/class-ordelist-duplicates.php:308
msgid "name"
msgstr "име"

#: includes/class-ordelist-duplicates.php:309
msgid "address"
msgstr "адрес"

#: includes/class-ordelist-duplicates.php:310
msgid "phone + name"
msgstr "телефон + име"

#: includes/class-ordelist-extras.php:32
msgid "OLE - split combos / convert extras now"
msgstr "OLE - разделяне на комбо / преобразуване на добавки"

#: includes/class-ordelist-extras.php:74
msgid "OLE - extras converted to product lines:"
msgstr "OLE - екстрите са преобразувани в продуктови редове:"

#. translators: 1: the combo product name, 2: the price the combo line had, 3: the resulting lines with their prices.
#: includes/class-ordelist-extras.php:460
#, php-format
msgid "Was: «%1$s» (%2$s) - split into: %3$s"
msgstr "Беше: «%1$s» (%2$s) - разделено на: %3$s"

