msgstr "телефон + име"

#: includes/class-ole-settings-page.php:26
msgid "Settings"
msgstr "Настройки"

#: includes/class-ole-settings-page.php:34
#: includes/class-ole-settings-page.php:35
#: includes/class-ole-settings-page.php:110
msgid "Order List Enhancer"
msgstr "Order List Enhancer"

#: includes/class-ole-settings-page.php:62
msgid "Saving…"
msgstr "Запазване…"

#: includes/class-ole-settings-page.php:63
msgid "Saved."
msgstr "Запазено."

#: includes/class-ole-settings-page.php:64
msgid "Save failed."
msgstr "Неуспешно запазване."

#: includes/class-ole-settings-page.php:113
msgid "Repeat customer highlighting"
msgstr "Маркиране на повтарящи се клиенти"

#: includes/class-ole-settings-page.php:116
msgid "Enable highlighting"
msgstr "Включи маркирането"

#: includes/class-ole-settings-page.php:117
msgid "Outline & badge same-customer orders in the list (with details modal)."
msgstr "Обвежда и маркира с бадж поръчките от един и същ клиент в списъка (с модал с детайли)."

#: includes/class-ole-settings-page.php:120
msgid "Match mode"
msgstr "Режим на съвпадение"

#: includes/class-ole-settings-page.php:124
msgid "By phone"
msgstr "По телефон"

#: includes/class-ole-settings-page.php:125
msgid "By name"
msgstr "По име"

#: includes/class-ole-settings-page.php:126
msgid "By name + phone"
msgstr "По име + телефон"

#: includes/class-ole-settings-page.php:128
msgid "How to decide two orders are from the same customer. Name + phone matches only when both the phone and the name match."
msgstr "Как се определя, че две поръчки са от един и същ клиент. Име + телефон съвпада само когато съвпадат и телефонът, и името."

#: includes/class-ole-settings-page.php:132
msgid "Scan limit"
msgstr "Лимит на сканиране"

#: includes/class-ole-settings-page.php:134
msgid "Maximum number of recent orders to scan across all statuses."
msgstr "Максимален брой последни поръчки за сканиране по всички статуси."

#: includes/class-ole-settings-page.php:137
msgid "Duplicate window (days)"
msgstr "Прозорец за дубликат (дни)"

#: includes/class-ole-settings-page.php:139
msgid "Two orders from the same customer within this many days (or 2+ in processing) are flagged as a likely duplicate."
msgstr "Две поръчки от един и същ клиент в рамките на толкова дни (или 2+ в обработка) се маркират като вероятен дубликат."

#: includes/class-ole-settings-page.php:143
msgid "Shipping coloring"
msgstr "Оцветяване на доставката"

#: includes/class-ole-settings-page.php:146
msgid "Color in orders list"
msgstr "Оцветяване в списъка с поръчки"

#: includes/class-ole-settings-page.php:147
msgid "Color the “Ship to” cell in the orders list."
msgstr "Оцветява клетката за доставка в списъка с поръчки."

#: includes/class-ole-settings-page.php:150
msgid "Color on edit page"
msgstr "Оцветяване на страницата за редакция"

#: includes/class-ole-settings-page.php:151
msgid "Color the address block on the single order edit screen."
msgstr "Оцветява блока с адреса на екрана за редакция на поръчка."

#: includes/class-ole-settings-page.php:154
msgid "Coloring rules"
msgstr "Правила за оцветяване"

#: includes/class-ole-settings-page.php:157
msgid "Keyword (in shipping address)"
msgstr "Ключова дума (в адреса за доставка)"

#: includes/class-ole-settings-page.php:158
#: includes/class-ole-settings-page.php:208
msgid "Color"
msgstr "Цвят"

#: includes/class-ole-settings-page.php:159
#: includes/class-ole-settings-page.php:209
msgid "Label"
msgstr "Етикет"

#: includes/class-ole-settings-page.php:171
#: includes/class-ole-settings-page.php:221
msgid "Add rule"
msgstr "Добави правило"

#: includes/class-ole-settings-page.php:175
msgid "Default color"
msgstr "Цвят по подразбиране"

#: includes/class-ole-settings-page.php:177
msgid "Used when no rule matches. Leave empty to not color unmatched rows."
msgstr "Използва се, когато няма съвпадение. Оставете празно, за да не оцветявате."

#: includes/class-ole-settings-page.php:180
msgid "Default label"
msgstr "Етикет по подразбиране"

#: includes/class-ole-settings-page.php:185
msgid "Order total coloring"
msgstr "Оцветяване по сума на поръчката"

#: includes/class-ole-settings-page.php:188
#: includes/class-ole-settings-page.php:230
msgid "Enable"
msgstr "Включи"

#: includes/class-ole-settings-page.php:189
msgid "Ring the order's row in the list — and its address panel on the order screen — when the total reaches a threshold below. Independent of the shipping color; the highest matched threshold wins."
msgstr "Очертава реда на поръчката в списъка — и панела с адреса на екрана за редакция — когато сумата достигне праг по-долу. Независимо от цвета на доставката; печели най-високият достигнат праг."

#: includes/class-ole-settings-page.php:192
msgid "Threshold rules"
msgstr "Правила за прагове"

#: includes/class-ole-settings-page.php:207
msgid "Order total ≥"
msgstr "Сума на поръчката ≥"

#: includes/class-ole-settings-page.php:222
msgid "When an order's total is at or above a threshold it gets a ring in that color. If several apply, the highest threshold wins. The ring is drawn on top of any shipping color — both stay visible."
msgstr "Когато сумата на поръчката е равна или над даден праг, тя получава очертание в съответния цвят. Ако се прилагат няколко, печели най-високият праг. Очертанието се рисува върху цвета на доставката — и двете остават видими."

#: includes/class-ole-settings-page.php:227
msgid "Order total on edit page"
msgstr "Сума на поръчката на страницата за редакция"

#: includes/class-ole-settings-page.php:231
msgid "Show the order total near the billing address on the order edit screen."
msgstr "Показва сумата на поръчката до адреса за фактуриране на екрана за редакция."

#: includes/class-ole-settings-page.php:234
msgid "Decimal separator"
msgstr "Десетичен разделител"

#: includes/class-ole-settings-page.php:238
msgid "Comma (,)"
msgstr "Запетая (,)"

#: includes/class-ole-settings-page.php:239
msgid "Dot (.)"
msgstr "Точка (.)"

#: includes/class-ole-settings-page.php:241
msgid "Decimal separator for the order total shown under the address (and its copy button)."
msgstr "Десетичен разделител за сумата на поръчката под адреса (и за бутона за копиране)."

#: includes/class-ole-settings-page.php:245
msgid "Copy buttons"
msgstr "Бутони за копиране"

#: includes/class-ole-settings-page.php:246
msgid "Show copy-to-clipboard buttons for name, phone and total on the order edit screen."
msgstr "Показва бутони за копиране на име, телефон и сума на екрана за редакция."

#: includes/class-ole-settings-page.php:250
msgid "Orders list — default bulk action"
msgstr "Списък с поръчки — групово действие по подразбиране"

#: includes/class-ole-settings-page.php:253
msgid "Pre-selected action"
msgstr "Предварително избрано действие"

#: includes/class-ole-settings-page.php:264
msgid "— (none)"
msgstr "— (няма)"

#: includes/class-ole-settings-page.php:269
msgid "Pre-selects this entry in the orders-list bulk-actions menu on page load. The list is filled from your Orders screen — open the Orders list once if it looks empty."
msgstr "Предварително избира тази стойност в менюто за групови действия на списъка с поръчки при зареждане на страницата. Списъкът се попълва от екрана с поръчки — отворете списъка с поръчки веднъж, ако изглежда празен."

#: includes/class-ole-settings-page.php:274
msgid "Extras → products"
msgstr "Екстри → продукти"

#: includes/class-ole-settings-page.php:277
msgid "Enable conversion"
msgstr "Включи преобразуването"

#: includes/class-ole-settings-page.php:278
msgid "At order creation, turn each mapped add-on extra into a real product line at the price the customer paid. Order total is unchanged."
msgstr "При създаване на поръчка превръща всяка съпоставена екстра в истински продуктов ред на цената, която клиентът е платил. Сумата на поръчката остава непроменена."

#: includes/class-ole-settings-page.php:281
msgid "Mapping (extra → product)"
msgstr "Съпоставяне (екстра → продукт)"

#: includes/class-ole-settings-page.php:290
msgid "Extra text (as shown on the order)"
msgstr "Текст на екстрата (както се показва в поръчката)"

#: includes/class-ole-settings-page.php:291
msgid "Product"
msgstr "Продукт"

#: includes/class-ole-settings-page.php:302
msgid "Search for a product…"
msgstr "Търсене на продукт…"

#: includes/class-ole-settings-page.php:315
msgid "Add row"
msgstr "Добави ред"

#: includes/class-ole-settings-page.php:316
msgid "Match is the exact extra label as it appears on the order/checkout (Product Add-On label like \"+ 500 г …\", or the Checkout Add-On name). The product line will be priced at what the customer paid for that extra."
msgstr "Съвпадението е точният етикет на екстрата, както се появява в поръчката/плащането (етикет на Product Add-On като \"+ 500 г …\" или името на Checkout Add-On). Продуктовият ред ще бъде на цената, която клиентът е платил за тази екстра."

#: includes/class-ole-settings-page.php:321
msgid "Checkout phone validation"
msgstr "Валидиране на телефон при плащане"

#: includes/class-ole-settings-page.php:324
msgid "Validate at checkout"
msgstr "Валидирай при плащане"

#: includes/class-ole-settings-page.php:325
msgid "Validate the billing phone number on the checkout (Bulgarian numbers) and flag invalid numbers in the admin."
msgstr "Валидира телефонния номер за фактуриране при плащане (български номера) и маркира невалидните номера в администрацията."

#: includes/class-ole-settings-page.php:328
msgid "When invalid"
msgstr "При невалиден"

#: includes/class-ole-settings-page.php:332
msgid "Warn only (allow the order, flag it)"
msgstr "Само предупреждение (разреши поръчката, маркирай я)"

#: includes/class-ole-settings-page.php:333
msgid "Block the order until fixed"
msgstr "Блокирай поръчката до коригиране"

#: includes/class-ole-settings-page.php:335
msgid "Country code comes from \"Default country code\" below (default 359). Invalid orders are flagged on the order page and in the orders list regardless of mode."
msgstr "Кодът на държавата идва от \"Код на държавата по подразбиране\" по-долу (по подразбиране 359). Невалидните поръчки се маркират на страницата на поръчката и в списъка с поръчки независимо от режима."

#: includes/class-ole-settings-page.php:340
msgid "Phone numbers"
msgstr "Телефонни номера"

#: includes/class-ole-settings-page.php:343
msgid "Normalize phone (display only)"
msgstr "Нормализация на телефон (само показване)"

#: includes/class-ole-settings-page.php:344
msgid "Tidy phone numbers for display: leading 00 → +, add the country code when missing. Never changes the database."
msgstr "Подрежда телефоните за показване: водещо 00 → +, добавя код на държавата, ако липсва. Не променя базата данни."

#: includes/class-ole-settings-page.php:347
msgid "Default country code"
msgstr "Код на държавата по подразбиране"

#: includes/class-ole-settings-page.php:349
msgid "Digits only, e.g. 359. Added to numbers that have no country code."
msgstr "Само цифри, напр. 359. Добавя се към номера без код на държавата."

#: includes/class-ole-settings-page.php:354
msgid "Save changes"
msgstr "Запази промените"

# Checkout phone validation
#: includes/class-ole-phone-checkout.php:27
msgid "Looks valid"
msgstr "Изглежда валиден"

#: includes/class-ole-phone-checkout.php:28
msgid "Please enter a phone number."
msgstr "Моля, въведете телефонен номер."

#: includes/class-ole-phone-checkout.php:29
msgid "The phone number looks too short. Example: 0888 123 456."
msgstr "Телефонният номер изглежда твърде къс. Пример: 0888 123 456."

#: includes/class-ole-phone-checkout.php:30
msgid "The phone number looks too long. Example: 0888 123 456."
msgstr "Телефонният номер изглежда твърде дълъг. Пример: 0888 123 456."

#: includes/class-ole-phone-checkout.php:31
msgid "Please enter a Bulgarian number (e.g. 0888 123 456)."
msgstr "Моля, въведете български номер (напр. 0888 123 456)."

#: includes/class-ole-phone-checkout.php:32
msgid "Invalid phone number. Example: 0888 123 456 or +359 888 123 456."
msgstr "Невалиден телефонен номер. Пример: 0888 123 456 или +359 888 123 456."

#: includes/class-ole-phone-checkout.php:97
msgid "Phone may be invalid — please verify."
msgstr "Телефонът може да е невалиден — моля, проверете."

